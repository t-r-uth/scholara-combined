# Firebase (client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Firebase Admin (server-side)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ORCID OAuth (defaults to sandbox if BASE URLs are unset/blank)
ORCID_CLIENT_ID=your-orcid-sandbox-client-id
ORCID_CLIENT_SECRET=your-orcid-sandbox-client-secret
ORCID_REDIRECT_URI=http://localhost:3000/api/auth/orcid/callback

# Production ORCID only — leave these unset (or delete) for sandbox.
# Do not set them to empty strings on Vercel.
# ORCID_BASE_URL=https://orcid.org
# ORCID_API_BASE_URL=https://pub.orcid.org/v3.0

# Email (Resend)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Scholara <noreply@scholara.app>

# App base URL (used in email links and ORCID redirects)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Vercel Cron Jobs — required in production when using vercel.json crons.
# Vercel sends Authorization: Bearer <CRON_SECRET> on scheduled requests.
CRON_SECRET=generate-a-long-random-string
